@prefix artinq: <https://humanum-p8.fr/omk_artificialinquiries/onto/artinq#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix o: <http://omeka.org/s/vocabs/o#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vs: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://humanum-p8.fr/omk_artificialinquiries/onto/artinq#> a owl:Ontology ;
    dcterms:title "Artificial Inquiries — vocabulaire commun"@fr ;
    dcterms:description "Vocabulaire commun recommandé, obtenu par rapprochement sémantique des classes et propriétés des vocabulaires produits pour les exercices du vademecum Artificial Inquiries. Chaque terme indique dans skos:scopeNote les termes d'origine qu'il remplace."@fr ;
    owl:versionInfo "1.0" ;
    skos:editorialNote "Non retenu : Ex. 2.b TaskManager — entité technique de l'application, pas un concept du domaine"@fr ;
    skos:editorialNote "Non retenu : Ex. 11 fichier — géré nativement par les médias Omeka"@fr ;
    skos:editorialNote "Non retenu : Ex. 11 typeMime — géré nativement par les médias Omeka"@fr ;
    skos:editorialNote "Non retenu : Ex. 13 frequencyScore ; Ex. 13 professionalStakesScore ; Ex. 13 expertiseRequiredScore ; Ex. 13 effortResourcesScore ; Ex. 13 collaborationScore ; Ex. 13 errorToleranceScore ; Ex. 13 standardisationScore ; Ex. 13 professionalPrideScore — remplacés par des instances de artinq:Critere notées via artinq:ScoreCritere"@fr .

# ────────────────────────────────────────────────────────────
# CLASSES
# ────────────────────────────────────────────────────────────

artinq:Participant a rdfs:Class ;
    rdfs:label "Participant"@fr, "Participant"@en ;
    rdfs:comment "Personne qui réalise un ou plusieurs exercices du vademecum."@fr ;
    skos:scopeNote "Rapprochements : Ex. 1 Participant ; Ex. 2.a Utilisateur ; Ex. 3.a Participant ; Ex. 4 Participant ; Ex. 5 Participant ; Ex. 8 Partner ; Ex. 11 Participant"@fr ;
    vs:term_status "testing" .

artinq:Exercice a rdfs:Class ;
    rdfs:label "Exercice"@fr, "Exercise"@en ;
    rdfs:comment "Exercice du vademecum Artificial Inquiries (numéro, bloc, consigne)."@fr ;
    skos:scopeNote "Rapprochements : Ex. 1 Exercice ; Ex. 6.c Exercice6c ; Ex. 8 Exercise ; Ex. 11 Exercice"@fr ;
    vs:term_status "testing" .

artinq:Question a rdfs:Class ;
    rdfs:label "Question"@fr, "Question"@en ;
    rdfs:comment "Question ou consigne d'un exercice à laquelle le participant répond."@fr ;
    skos:scopeNote "Rapprochements : Ex. 1 Question"@fr ;
    vs:term_status "testing" .

artinq:Passation a rdfs:Class ;
    rdfs:label "Passation"@fr, "Session"@en ;
    rdfs:comment "Séance au cours de laquelle un participant réalise un exercice, à une date et un moment donnés."@fr ;
    skos:scopeNote "Rapprochements : Ex. 1 Passation ; Ex. 3.a SessionImpressions ; Ex. 3.b Parcours"@fr ;
    vs:term_status "testing" .

artinq:Reponse a rdfs:Class ;
    rdfs:label "Réponse"@fr, "Answer"@en ;
    rdfs:comment "Réponse d'un participant à une question pendant une passation (classe abstraite)."@fr ;
    skos:scopeNote "Rapprochements : Ex. 1 Reponse"@fr ;
    vs:term_status "testing" .

artinq:ReponseDessin a rdfs:Class ;
    rdfs:label "Réponse dessin"@fr, "Drawing answer"@en ;
    rdfs:comment "Réponse dessinée, composée de traits ; l'image est jointe en média."@fr ;
    rdfs:subClassOf artinq:Reponse ;
    skos:scopeNote "Rapprochements : Ex. 1 ReponseDessin"@fr ;
    vs:term_status "testing" .

artinq:ReponseTexte a rdfs:Class ;
    rdfs:label "Réponse texte"@fr, "Text answer"@en ;
    rdfs:comment "Réponse écrite à une question."@fr ;
    rdfs:subClassOf artinq:Reponse ;
    skos:scopeNote "Rapprochements : Ex. 1 ReponseTexte"@fr ;
    vs:term_status "testing" .

artinq:Trait a rdfs:Class ;
    rdfs:label "Trait"@fr, "Stroke"@en ;
    rdfs:comment "Trait d'un dessin : outil, couleur, épaisseur et points."@fr ;
    skos:scopeNote "Rapprochements : Ex. 1 Trait"@fr ;
    vs:term_status "testing" .

artinq:Tache a rdfs:Class ;
    rdfs:label "Tâche"@fr, "Task"@en ;
    rdfs:comment "Tâche (professionnelle ou personnelle) décrite par le participant et éventuellement confiée à un LLM."@fr ;
    skos:scopeNote "Rapprochements : Ex. 2.a Tache ; Ex. 2.b Task ; Ex. 3.a TacheDeleguee ; Ex. 6 Task ; Ex. 6 CoreTask ; Ex. 6.c Tache ; Ex. 7.b Tache ; Ex. 8 Task ; Ex. 10.a Task"@fr ;
    vs:term_status "testing" .

artinq:CategorieTache a rdfs:Class ;
    rdfs:label "Catégorie de tâche"@fr, "Task category"@en ;
    rdfs:comment "Catégorie servant à classer des tâches ou des conversations (ex. BUSINESS, PLEASURE)."@fr ;
    skos:scopeNote "Rapprochements : Ex. 3.b Categorie ; Ex. 4 CategorieTache ; Ex. 6 Category"@fr ;
    vs:term_status "testing" .

artinq:Role a rdfs:Class ;
    rdfs:label "Rôle"@fr, "Role"@en ;
    rdfs:comment "Rôle ou responsabilité attribué soit à l'IA, soit conservé par l'humain."@fr ;
    skos:scopeNote "Rapprochements : Ex. 2.b AIRole ; Ex. 2.b HumanResponsibility"@fr ;
    vs:term_status "testing" .

artinq:LLM a rdfs:Class ;
    rdfs:label "Modèle de langage (LLM)"@fr, "Language model"@en ;
    rdfs:comment "Modèle d'IA utilisé (ChatGPT, Claude, Mistral…)."@fr ;
    skos:scopeNote "Rapprochements : Ex. 4 LLM ; Ex. 5 LLM ; Ex. 7.b ModeleIA ; Ex. 8 Model ; Ex. 10.a LLM"@fr ;
    vs:term_status "testing" .

artinq:Prompt a rdfs:Class ;
    rdfs:label "Prompt"@fr, "Prompt"@en ;
    rdfs:comment "Instruction donnée à un LLM pour réaliser une tâche."@fr ;
    skos:scopeNote "Rapprochements : Ex. 10.a Prompt"@fr ;
    vs:term_status "testing" .

artinq:Test a rdfs:Class ;
    rdfs:label "Test"@fr, "Test"@en ;
    rdfs:comment "Soumission d'un même prompt à un ou plusieurs LLM."@fr ;
    skos:scopeNote "Rapprochements : Ex. 7.b Test"@fr ;
    vs:term_status "testing" .

artinq:ReponseLLM a rdfs:Class ;
    rdfs:label "Réponse d'un LLM"@fr, "LLM output"@en ;
    rdfs:comment "Résultat produit par un LLM lors d'un test ou d'une tâche."@fr ;
    skos:scopeNote "Rapprochements : Ex. 7.b Reponse ; Ex. 8 Response ; Ex. 10.a Result"@fr ;
    vs:term_status "testing" .

artinq:CodeAnonyme a rdfs:Class ;
    rdfs:label "Code d'anonymisation"@fr, "Blind code"@en ;
    rdfs:comment "Code (ex. nom d'animal) qui masque l'identité d'un LLM pendant un test à l'aveugle."@fr ;
    skos:scopeNote "Rapprochements : Ex. 8 AnimalCode"@fr ;
    vs:term_status "testing" .

artinq:Historique a rdfs:Class ;
    rdfs:label "Historique de conversations"@fr, "Conversation history"@en ;
    rdfs:comment "Ensemble des conversations d'un participant avec des LLM."@fr ;
    skos:scopeNote "Rapprochements : Ex. 3.b Historique"@fr ;
    vs:term_status "testing" .

artinq:Conversation a rdfs:Class ;
    rdfs:label "Conversation"@fr, "Conversation"@en ;
    rdfs:comment "Conversation entre un participant et un LLM."@fr ;
    skos:scopeNote "Rapprochements : Ex. 3.b Conversation ; Ex. 5 Conversation"@fr ;
    vs:term_status "testing" .

artinq:ConversationMarquante a rdfs:Class ;
    rdfs:label "Conversation marquante"@fr, "Memorable conversation"@en ;
    rdfs:comment "Conversation qui a laissé une impression durable."@fr ;
    rdfs:subClassOf artinq:Conversation ;
    skos:scopeNote "Rapprochements : Ex. 3.a ConversationMarquante ; Ex. 3.b ConversationMemorable ; Ex. 4 ConversationMemorable"@fr ;
    vs:term_status "testing" .

artinq:Echange a rdfs:Class ;
    rdfs:label "Échange"@fr, "Exchange"@en ;
    rdfs:comment "Un message du participant et la réponse du LLM au sein d'une conversation."@fr ;
    skos:scopeNote "Rapprochements : Ex. 5 Interaction"@fr ;
    vs:term_status "testing" .

artinq:Emotion a rdfs:Class ;
    rdfs:label "Émotion"@fr, "Emotion"@en ;
    rdfs:comment "Émotion associée à une conversation (enthousiasme, frustration, surprise…)."@fr ;
    skos:scopeNote "Rapprochements : Ex. 4 Emotion"@fr ;
    vs:term_status "testing" .

artinq:TypeImpact a rdfs:Class ;
    rdfs:label "Type d'impact"@fr, "Impact type"@en ;
    rdfs:comment "Nature de l'impact d'une conversation sur le participant."@fr ;
    skos:scopeNote "Rapprochements : Ex. 4 TypeImpact"@fr ;
    vs:term_status "testing" .

artinq:Terme a rdfs:Class ;
    rdfs:label "Terme"@fr, "Term"@en ;
    rdfs:comment "Mot de remplacement pour désigner un interlocuteur (humain ou LLM)."@fr ;
    skos:scopeNote "Rapprochements : Ex. 5 Terme"@fr ;
    vs:term_status "testing" .

artinq:Substitution a rdfs:Class ;
    rdfs:label "Substitution"@fr, "Substitution"@en ;
    rdfs:comment "Tour de substitution attribuant de nouveaux rôles au participant et au LLM."@fr ;
    skos:scopeNote "Rapprochements : Ex. 5 Substitution"@fr ;
    vs:term_status "testing" .

artinq:Evaluation a rdfs:Class ;
    rdfs:label "Évaluation"@fr, "Evaluation"@en ;
    rdfs:comment "Jugement porté sur une tâche, un terme, une réponse ou une œuvre."@fr ;
    skos:scopeNote "Rapprochements : Ex. 5 EvaluationTerme ; Ex. 6 TaskAssessment ; Ex. 6.c Evaluation ; Ex. 13 Evaluation"@fr ;
    vs:term_status "testing" .

artinq:Attente a rdfs:Class ;
    rdfs:label "Attente envers le LLM"@fr, "LLM expectation"@en ;
    rdfs:comment "Niveau de performance attendu et critères d'échec, de résultat acceptable et de réussite."@fr ;
    skos:scopeNote "Rapprochements : Ex. 6 LLMExpectation ; Ex. 6.c Attentes"@fr ;
    vs:term_status "testing" .

artinq:NiveauPerformance a rdfs:Class ;
    rdfs:label "Niveau de performance"@fr, "Performance level"@en ;
    rdfs:comment "Échelle : TERRIBLE, PRETTY_BAD, GOOD_ENOUGH, EXCELLENT."@fr ;
    skos:scopeNote "Rapprochements : Ex. 6 ExpectationLevel"@fr ;
    vs:term_status "testing" .

artinq:Critere a rdfs:Class ;
    rdfs:label "Critère"@fr, "Criterion"@en ;
    rdfs:comment "Critère d'évaluation (fréquence, enjeux, expertise, effort, collaboration, tolérance à l'erreur, standardisation, fierté)."@fr ;
    skos:scopeNote "Rapprochements : Ex. 13 Criterion ; Ex. 6 ResultCriteria"@fr ;
    vs:term_status "testing" .

artinq:ScoreCritere a rdfs:Class ;
    rdfs:label "Score de critère"@fr, "Criterion score"@en ;
    rdfs:comment "Note de 1 à 5 attribuée à un critère dans une évaluation."@fr ;
    skos:scopeNote "Rapprochements : Ex. 13 CriterionScore"@fr ;
    vs:term_status "testing" .

artinq:Reflexion a rdfs:Class ;
    rdfs:label "Réflexion"@fr, "Reflection"@en ;
    rdfs:comment "Texte de réflexion, de synthèse ou de justification rédigé par le participant."@fr ;
    skos:scopeNote "Rapprochements : Ex. 2.b Reflection ; Ex. 3.b Fiche ; Ex. 5 Reflexion ; Ex. 11 Reflexion ; Ex. 13 Justification"@fr ;
    vs:term_status "testing" .

artinq:Observation a rdfs:Class ;
    rdfs:label "Observation"@fr, "Observation"@en ;
    rdfs:comment "Observation datée sur l'usage des LLM (avant, pendant ou après)."@fr ;
    skos:scopeNote "Rapprochements : Ex. 11 Observation"@fr ;
    vs:term_status "testing" .

artinq:Dimension a rdfs:Class ;
    rdfs:label "Dimension"@fr, "Dimension"@en ;
    rdfs:comment "Dimension d'analyse d'une réflexion."@fr ;
    skos:scopeNote "Rapprochements : Ex. 11 Dimension"@fr ;
    vs:term_status "testing" .

artinq:Exemple a rdfs:Class ;
    rdfs:label "Exemple"@fr, "Example"@en ;
    rdfs:comment "Exemple concret (extrait de conversation, lien) illustrant une observation."@fr ;
    skos:scopeNote "Rapprochements : Ex. 11 Exemple"@fr ;
    vs:term_status "testing" .

artinq:Document a rdfs:Class ;
    rdfs:label "Document"@fr, "Document"@en ;
    rdfs:comment "Ressource documentaire ou média associé (fichier, source, capture)."@fr ;
    skos:scopeNote "Rapprochements : Ex. 8 Document ; Ex. 11 Media ; Ex. 13 DocumentaryResource"@fr ;
    vs:term_status "testing" .

artinq:OeuvreExemplaire a rdfs:Class ;
    rdfs:label "Œuvre exemplaire"@fr, "Exemplary work"@en ;
    rdfs:comment "Travail ou document professionnel choisi pour son exemplarité."@fr ;
    skos:scopeNote "Rapprochements : Ex. 13 ExemplaryWork"@fr ;
    vs:term_status "testing" .

artinq:De a rdfs:Class ;
    rdfs:label "Dé"@fr, "Die"@en ;
    rdfs:comment "Dé utilisé pour parcourir l'historique de manière aléatoire."@fr ;
    skos:scopeNote "Rapprochements : Ex. 3.b De"@fr ;
    vs:term_status "testing" .

# ────────────────────────────────────────────────────────────
# PROPRIÉTÉS
# ────────────────────────────────────────────────────────────

artinq:identifiant a rdf:Property ;
    rdfs:label "identifiant"@fr, "identifier"@en ;
    rdfs:comment "Identifiant d'une ressource."@fr ;
    rdfs:domain o:Resource ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dcterms:identifier ;
    skos:scopeNote "Rapprochements : Ex. 2.a idUtilisateur ; Ex. 2.a idTache ; Ex. 6.c taskId ; Ex. 8 id ; Ex. 8 taskId ; Ex. 10.a taskId"@fr ;
    vs:term_status "testing" .

artinq:titre a rdf:Property ;
    rdfs:label "titre"@fr, "title"@en ;
    rdfs:comment "Titre ou intitulé d'un exercice, d'une tâche, d'une conversation."@fr ;
    rdfs:domain o:Resource ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dcterms:title ;
    skos:scopeNote "Rapprochements : Ex. 1 titre ; Ex. 2.a nomTache ; Ex. 2.b taskName ; Ex. 3.b titre ; Ex. 6.c titre ; Ex. 8 title ; Ex. 11 titreExercice"@fr ;
    vs:term_status "testing" .

artinq:nom a rdf:Property ;
    rdfs:label "nom"@fr, "name"@en ;
    rdfs:comment "Nom d'une personne, d'un modèle, d'une catégorie ou d'un rôle."@fr ;
    rdfs:domain o:Resource ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf foaf:name ;
    skos:scopeNote "Rapprochements : Ex. 2.a nom ; Ex. 2.b roleName ; Ex. 2.b responsibilityName ; Ex. 3.b nom ; Ex. 4 name ; Ex. 8 name ; Ex. 10.a name"@fr ;
    vs:term_status "testing" .

artinq:description a rdf:Property ;
    rdfs:label "description"@fr, "description"@en ;
    rdfs:comment "Description libre."@fr ;
    rdfs:domain o:Resource ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dcterms:description ;
    skos:scopeNote "Rapprochements : Ex. 2.b explanation ; Ex. 6.c description ; Ex. 8 description"@fr ;
    vs:term_status "testing" .

artinq:type a rdf:Property ;
    rdfs:label "type"@fr, "type"@en ;
    rdfs:comment "Type ou nature (valeur contrôlée, ex. DESSIN/TEXTE, EVOLUTION/CONSTANCE)."@fr ;
    rdfs:domain o:Resource ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dcterms:type ;
    skos:scopeNote "Rapprochements : Ex. 1 typeQuestion ; Ex. 5 typeTerme ; Ex. 8 type ; Ex. 10.a type ; Ex. 11 typeReflexion"@fr ;
    vs:term_status "testing" .

artinq:date a rdf:Property ;
    rdfs:label "date"@fr, "date"@en ;
    rdfs:comment "Date (et heure) de saisie, de passation, de test ou d'évaluation."@fr ;
    rdfs:domain o:Resource ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf dcterms:date ;
    skos:scopeNote "Rapprochements : Ex. 1 datePassation ; Ex. 3.b date ; Ex. 7.b dateTest ; Ex. 11 dateSaisie ; Ex. 11 dateObservation ; Ex. 13 evaluationDate"@fr ;
    vs:term_status "testing" .

artinq:dateModification a rdf:Property ;
    rdfs:label "date de modification"@fr, "modified"@en ;
    rdfs:comment "Date de dernière modification."@fr ;
    rdfs:domain o:Resource ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf dcterms:modified ;
    skos:scopeNote "Rapprochements : Ex. 1 modifieeLe"@fr ;
    vs:term_status "testing" .

artinq:texte a rdf:Property ;
    rdfs:label "texte"@fr, "text"@en ;
    rdfs:comment "Contenu textuel (réponse, impression, contenu d'une réponse de LLM)."@fr ;
    rdfs:domain o:Resource ;
    rdfs:range xsd:string ;
    skos:scopeNote "Rapprochements : Ex. 1 texte ; Ex. 3.a impression ; Ex. 4 content ; Ex. 7.b contenu ; Ex. 8 content ; Ex. 10.a content ; Ex. 11 texte"@fr ;
    vs:term_status "testing" .

artinq:resume a rdf:Property ;
    rdfs:label "résumé"@fr, "summary"@en ;
    rdfs:comment "Résumé ou synthèse."@fr ;
    rdfs:domain o:Resource ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dcterms:abstract ;
    skos:scopeNote "Rapprochements : Ex. 2.b summary ; Ex. 11 resume"@fr ;
    vs:term_status "testing" .

artinq:url a rdf:Property ;
    rdfs:label "URL"@fr, "URL"@en ;
    rdfs:comment "Adresse web d'une conversation ou d'une référence."@fr ;
    rdfs:domain o:Resource ;
    rdfs:range xsd:anyURI ;
    skos:scopeNote "Rapprochements : Ex. 11 urlConversation ; Ex. 13 referenceUrl"@fr ;
    vs:term_status "testing" .

artinq:numero a rdf:Property ;
    rdfs:label "numéro"@fr, "number"@en ;
    rdfs:comment "Numéro d'un exercice ou d'un échange."@fr ;
    rdfs:domain o:Resource ;
    rdfs:range xsd:string ;
    skos:scopeNote "Rapprochements : Ex. 1 numero ; Ex. 5 numero ; Ex. 11 numero"@fr ;
    vs:term_status "testing" .

artinq:ordre a rdf:Property ;
    rdfs:label "ordre"@fr, "order"@en ;
    rdfs:comment "Position dans une séquence (rang, tour, position)."@fr ;
    rdfs:domain o:Resource ;
    rdfs:range xsd:integer ;
    skos:scopeNote "Rapprochements : Ex. 1 ordre ; Ex. 3.a rang ; Ex. 3.b position ; Ex. 5 tour ; Ex. 6 position"@fr ;
    vs:term_status "testing" .

artinq:statut a rdf:Property ;
    rdfs:label "statut"@fr, "status"@en ;
    rdfs:comment "Statut (ex. simulation, succès, erreur)."@fr ;
    rdfs:domain o:Resource ;
    rdfs:range xsd:string ;
    skos:scopeNote "Rapprochements : Ex. 7.b statut"@fr ;
    vs:term_status "testing" .

artinq:pseudo a rdf:Property ;
    rdfs:label "pseudo"@fr, "nickname"@en ;
    rdfs:comment "Pseudo ou identifiant de connexion du participant."@fr ;
    rdfs:domain artinq:Participant ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf foaf:nick ;
    skos:scopeNote "Rapprochements : Ex. 1 pseudo ; Ex. 11 login"@fr ;
    vs:term_status "testing" .

artinq:compteGithub a rdf:Property ;
    rdfs:label "compte GitHub"@fr, "GitHub account"@en ;
    rdfs:comment "Identifiant GitHub du participant."@fr ;
    rdfs:domain artinq:Participant ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf foaf:accountName ;
    skos:scopeNote "Rapprochements : Ex. 5 compteGithub"@fr ;
    vs:term_status "testing" .

artinq:profession a rdf:Property ;
    rdfs:label "profession"@fr, "profession"@en ;
    rdfs:comment "Métier ou profession du participant."@fr ;
    rdfs:domain artinq:Participant ;
    rdfs:range xsd:string ;
    skos:scopeNote "Rapprochements : Ex. 3.a metier ; Ex. 11 profession"@fr ;
    vs:term_status "testing" .

artinq:dateInscription a rdf:Property ;
    rdfs:label "date d'inscription"@fr, "registration date"@en ;
    rdfs:comment "Date d'inscription du participant."@fr ;
    rdfs:domain artinq:Participant ;
    rdfs:range xsd:dateTime ;
    skos:scopeNote "Rapprochements : Ex. 1 inscritLe"@fr ;
    vs:term_status "testing" .

artinq:utiliseLLM a rdf:Property ;
    rdfs:label "utilise le LLM"@fr, "uses LLM"@en ;
    rdfs:comment "Relie un participant, une conversation, un test ou une tâche au LLM utilisé."@fr ;
    rdfs:domain o:Resource ;
    rdfs:range artinq:LLM ;
    skos:scopeNote "Rapprochements : Ex. 3.a llmPrincipal ; Ex. 4 usesLLM ; Ex. 5 avecLLM ; Ex. 7.b utiliseModele ; Ex. 8 tests ; Ex. 10.a usesLLM ; Ex. 11 llmUtilise"@fr ;
    vs:term_status "testing" .

artinq:frequence a rdf:Property ;
    rdfs:label "fréquence"@fr, "frequency"@en ;
    rdfs:comment "Fréquence d'une tâche ou de l'usage d'un LLM."@fr ;
    rdfs:domain o:Resource ;
    rdfs:range xsd:string ;
    skos:scopeNote "Rapprochements : Ex. 2.a frequence ; Ex. 2.b frequency ; Ex. 3.a frequence"@fr ;
    vs:term_status "testing" .

artinq:dureeMinuteur a rdf:Property ;
    rdfs:label "durée du minuteur"@fr, "timer duration"@en ;
    rdfs:comment "Durée du minuteur en secondes."@fr ;
    rdfs:domain artinq:Passation ;
    rdfs:range xsd:integer ;
    skos:scopeNote "Rapprochements : Ex. 3.a dureeMinuteur"@fr ;
    vs:term_status "testing" .

artinq:partEchangesCourts a rdf:Property ;
    rdfs:label "part d'échanges courts"@fr, "share of short exchanges"@en ;
    rdfs:comment "Pourcentage de conversations à une seule question-réponse."@fr ;
    rdfs:domain artinq:Passation ;
    rdfs:range xsd:decimal ;
    skos:scopeNote "Rapprochements : Ex. 3.a partEchangesCourts"@fr ;
    vs:term_status "testing" .

artinq:partConversationsLongues a rdf:Property ;
    rdfs:label "part de conversations longues"@fr, "share of long conversations"@en ;
    rdfs:comment "Pourcentage de conversations à plusieurs allers-retours."@fr ;
    rdfs:domain artinq:Passation ;
    rdfs:range xsd:decimal ;
    skos:scopeNote "Rapprochements : Ex. 3.a partConversationsLongues"@fr ;
    vs:term_status "testing" .

artinq:partDialoguesEtendus a rdf:Property ;
    rdfs:label "part de dialogues étendus"@fr, "share of extended dialogues"@en ;
    rdfs:comment "Pourcentage de conversations de plus d'une journée."@fr ;
    rdfs:domain artinq:Passation ;
    rdfs:range xsd:decimal ;
